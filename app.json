{
  "expo": {
    "name": "NQFT Robot Controller",
    "slug": "nqft-robot-controller",
    "scheme": "nqft-robot-controller",
    "version": "1.0.0",
    "orientation": "landscape",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      [
        "react-native-ble-manager",
        {
          "neverForLocation": true,
          "bluetoothAlwaysPermission": "Allow $(PRODUCT_NAME) to scan for and connect to the ESP32 robot."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "baseUrl": "/NQFT"
    },
    "ios": {
      "bundleIdentifier": "com.juctxy.nqftrobotcontroller",
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "fa25d747-2a15-457a-95d3-663589fceb77"
      }
    }
  }
}